# Slim image for Render's free tier (512 MB RAM). No browser binaries: scans
# run in a hosted browser reached over CDP (BROWSER_WS_ENDPOINT). The pip
# playwright wheel ships only its small driver, which is all connect_over_cdp
# needs. The Railway deployment keeps using ./Dockerfile, which bundles
# Chromium for local scanning.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# Only the application code; tests, scripts and the frontend stay out.
COPY backend/__init__.py ./backend/__init__.py
COPY backend/app ./backend/app

RUN useradd --create-home --uid 10001 app
USER app

EXPOSE 8080
# Render injects PORT; default to 8080 for local runs.
CMD ["sh", "-c", "exec uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
