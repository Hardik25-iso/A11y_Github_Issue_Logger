# AI provider: ollama | anthropic | groq | auto | template
AI_PROVIDER=template
AI_TIMEOUT_SECONDS=30

# Ollama (free, runs locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=

# GitHub — fine-grained PAT with Issues read/write on your repo
GITHUB_TOKEN=
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name

# Backend
FRONTEND_ORIGINS=http://localhost:5173
ENABLE_LIVE_SCAN=false
SCAN_TIMEOUT_MS=30000
BLOCK_HEAVY_SCAN_RESOURCES=true

# Remote browser (optional). Blank = launch a local Playwright Chromium.
# Set a CDP endpoint to scan in a hosted browser instead, e.g. Browserless:
#   BROWSER_WS_ENDPOINT=wss://production-sfo.browserless.io?token=YOUR_TOKEN
BROWSER_WS_ENDPOINT=
# Concurrent scans; match the hosted plan (1 on the Browserless free tier)
BROWSER_MAX_CONCURRENCY=3
BROWSER_CONNECT_TIMEOUT_MS=8000
# Remote scans only: hard cap per scan, kept under one 30 s billed unit
SCAN_TOTAL_TIMEOUT_S=28
